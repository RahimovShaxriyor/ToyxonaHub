# ==============================================================================
# ToyxonaHub - Backend Environment Configuration (.env.example)
# Use these values when running backend locally on the host machine.
# ==============================================================================

# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (Docker PostgreSQL exposed on localhost:5432)
DATABASE_URL=postgresql://toyxona_user:toyxona_password@localhost:5432/toyxonahub?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_toyxonahub_2026_super_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_toyxonahub_2026_super_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis 7 Configuration (Docker Redis exposed on localhost:6379)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5

# MinIO / S3 Object Storage (Docker MinIO exposed on localhost:9000)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toyxonahub-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email / Mailpit SMTP (Docker Mailpit exposed on localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@toyxonahub.uz

# File Upload Settings (Fallback local directory)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
