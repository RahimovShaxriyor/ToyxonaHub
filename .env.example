# ==============================================================================
# ToyxonaHub - Root Environment Configuration Template (.env.example)
# Copy to .env in root directory for docker compose overrides.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5050
FRONTEND_PORT=5173
FRONTEND_URL=*

# PostgreSQL 16 (Container Service: postgres)
POSTGRES_USER=toyxona_user
POSTGRES_PASSWORD=toyxona_password
POSTGRES_DB=toyxonahub
POSTGRES_PORT=5432

# In Docker container network:
DATABASE_URL=postgresql://toyxona_user:toyxona_password@postgres:5432/toyxonahub?schema=public
# For local host development connecting to Docker PostgreSQL:
# DATABASE_URL=postgresql://toyxona_user:toyxona_password@localhost:5432/toyxonahub?schema=public

# Redis 7 (Container Service: redis)
REDIS_PORT=6379
# In Docker container network:
REDIS_URL=redis://redis:6379
# For local host development connecting to Docker Redis:
# REDIS_URL=redis://localhost:6379

CACHE_TTL_SECONDS=300
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5

# MinIO / S3 Object Storage (Container Service: minio)
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=toyxonahub-images
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# In Docker container network:
S3_ENDPOINT=http://minio:9000
# Browser/Client access to public images:
S3_PUBLIC_URL=http://localhost:9000

# Mailpit SMTP / Dev Mailer (Container Service: mailpit)
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
# In Docker container network:
SMTP_HOST=mailpit
# For local host development:
# SMTP_HOST=localhost
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@toyxonahub.uz

# JWT Authentication
JWT_ACCESS_SECRET=toyxonahub_super_secret_access_jwt_key_2026
JWT_REFRESH_SECRET=toyxonahub_super_secret_refresh_jwt_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=./uploads
